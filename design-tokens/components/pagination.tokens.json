{
  "pagination": {
    "$description": "Pagination's component tokens. Each one is an optional override: set the CSS variable (--pagination-<name>) on the page, a container or one pagination, and everything inside follows. Unset, it uses the shared token it references here; tools/test/foundation.py checks that bundle.css uses exactly these defaults.",
    "color": {
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "A page number and the arrows.",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-text"
          }
        }
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{color.secondary}",
        "$description": "A page or arrow on hover.",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-bg-hover"
          }
        }
      },
      "current-bg": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "The current page's background.",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-current-bg"
          }
        }
      },
      "current-text": {
        "$type": "color",
        "$value": "{color.on-primary}",
        "$description": "The current page's number (4.5:1 on current-bg).",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-current-text"
          }
        }
      },
      "ellipsis": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The … between page ranges (4.5:1 on surface).",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-ellipsis"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The keyboard focus ring.",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-focus-ring"
          }
        }
      }
    },
    "typography": {
      "font-size": {
        "$type": "dimension",
        "$value": "{fontSize.text-sm}",
        "$description": "Page numbers (14px).",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-font-size"
          }
        }
      },
      "weight-current": {
        "$type": "fontWeight",
        "$value": "{typography.font-semibold}",
        "$description": "The current page's weight (600).",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-weight-current"
          }
        }
      }
    },
    "sizing": {
      "size": {
        "$type": "dimension",
        "$value": "{sizing.control-height-md}",
        "$description": "A page's width and height at size md (32px).",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-size"
          }
        }
      },
      "size-sm": {
        "$type": "dimension",
        "$value": "{sizing.control-height-sm}",
        "$description": "At size sm (24px).",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-size-sm"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space between pages (4px).",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-gap"
          }
        }
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Side padding inside a page, for wide numbers (8px).",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-padding-x"
          }
        }
      }
    },
    "radius": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-md}",
        "$description": "A page's corners (6px).",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-radius"
          }
        }
      }
    },
    "opacity": {
      "disabled": {
        "$type": "number",
        "$value": "{opacity.opacity-50}",
        "$description": "Previous or next when there's no page that way.",
        "$extensions": {
          "com.diki": {
            "cssVar": "--pagination-disabled"
          }
        }
      }
    }
  }
}
