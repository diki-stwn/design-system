{
  "extends": "stylelint-config-recommended",
  "ignoreFiles": [
    "dist/**",
    "storybook-static/**",
    "node_modules/**",
    "tokens.css",
    "src/styles/utilities.template.css"
  ],
  "rules": {
    "no-descending-specificity": null,
    "no-duplicate-selectors": null,
    "property-no-deprecated": [
      true,
      {
        "ignoreProperties": [
          "-webkit-box-orient"
        ]
      }
    ],
    "declaration-property-value-no-unknown": [
      true,
      {
        "ignoreProperties": {
          "mix-blend-mode": [
            "plus-darker"
          ],
          "justify-content": [
            "baseline"
          ]
        }
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/components/**/*.css"
      ],
      "rules": {
        "property-disallowed-list": [
          [
            "left",
            "right",
            "/^margin-(left|right)$/",
            "/^padding-(left|right)$/",
            "/^border-(left|right)(-|$)/",
            "/^border-(top|bottom)-(left|right)-radius$/",
            "/^scroll-(margin|padding)-(left|right)$/"
          ],
          {
            "message": "Use the logical property (inset-inline-*, margin-inline-*, padding-inline-*, border-inline-*, border-*-start/end-radius), so the component works in right-to-left text."
          }
        ],
        "declaration-property-value-disallowed-list": [
          {
            "float": [
              "/^(left|right)$/"
            ],
            "clear": [
              "/^(left|right)$/"
            ],
            "text-align": [
              "/^(left|right)$/"
            ]
          },
          {
            "message": "Use inline-start or inline-end (start or end for text-align), so the component works in right-to-left text."
          }
        ]
      }
    }
  ]
}
