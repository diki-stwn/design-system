{
  "name": "@diki/design-system",
  "version": "4.8.1",
  "private": true,
  "type": "module",
  "description": "Diki Design System: tokens, utility classes, page defaults, automatic dark mode and React components. Import the components as ES modules (React 18+ is a peer dependency), or load dist/diki.iife.js on a plain page, where it reads window.React (React 18.3.1 ships in dist/lib/).",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/bundle.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./base.css": "./dist/base.css",
    "./bundle.css": "./dist/bundle.css",
    "./components.css": "./dist/components.css",
    "./utilities.css": "./dist/utilities.css",
    "./bundle.js": "./dist/bundle.js",
    "./diki.iife.js": "./dist/diki.iife.js",
    "./theme.js": "./dist/theme.js",
    "./design-tokens/*": "./design-tokens/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "tokens.css",
    "tokens.json",
    "fonts/",
    "licenses/",
    "design-tokens/",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "./dist/theme.js",
    "./dist/diki.iife.js",
    "./dist/bundle.js"
  ],
  "scripts": {
    "build": "node tools/build/build.mjs",
    "typecheck": "tsc -p .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "prepare": "node tools/build/build.mjs",
    "pretest": "node tools/build/build.mjs",
    "test": "node tools/test/run.mjs",
    "tokens": "node tools/tokens/build.mjs && node tools/tokens/export.mjs",
    "test:safari": "node tools/test/run.mjs --compat safari",
    "test:firefox": "node tools/test/run.mjs --browser firefox",
    "test:webkit": "node tools/test/run.mjs --browser webkit",
    "changeset": "changeset",
    "version-packages": "node tools/version.mjs",
    "release": "node tools/publish.mjs",
    "lint": "eslint . && stylelint \"src/**/*.css\" \".storybook/**/*.css\"",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@eslint/js": "9.39.5",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.13.0",
    "playwright": "1.56.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "10.6.2",
    "style-dictionary": "5.6.0",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "14.0.1",
    "tsup": "8.5.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.3",
    "vitest": "4.1.12",
    "vitest-browser-react": "2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
