{
  "text": {
    "$description": "Text's component tokens. Each one is an optional override: set the CSS variable (--text-<name>) on the page, a container or one element, and everything inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "tone=\"default\".",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--text-tone-default"
          }
        }
      },
      "color-muted": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "tone=\"muted\": secondary text (4.5:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--text-tone-muted"
          }
        }
      },
      "color-primary": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "tone=\"primary\".",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--text-tone-primary"
          }
        }
      },
      "color-danger": {
        "$type": "color",
        "$value": "{color.danger-text}",
        "$description": "tone=\"danger\": error text (4.5:1 on surface and danger-subtle).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--text-tone-danger"
          }
        }
      }
    }
  }
}
