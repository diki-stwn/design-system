{
  "name": "@diki/design-system",
  "version": "4.7.0",
  "private": true,
  "description": "Diki Design System: tokens, utility classes, page defaults, automatic dark mode and React components. Self-contained: fonts and React ship with it. bundle.js is a browser script that reads React from window.React (React 18.3.1 ships in components/lib/).",
  "style": "components/bundle.css",
  "types": "components/index.d.ts",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./base.css": "./components/base.css",
    "./bundle.css": "./components/bundle.css",
    "./bundle.js": "./components/bundle.js",
    "./theme.js": "./components/theme.js",
    "./design-tokens/*": "./design-tokens/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "tokens.css",
    "tokens.json",
    "components/",
    "fonts/",
    "licenses/",
    "design-tokens/",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "components/theme.js",
    "components/bundle.js"
  ],
  "scripts": {
    "test": "node tools/test/run.mjs",
    "docs": "python3 tools/docs/build.py . docs-site",
    "tokens": "python3 tools/tokens/export.py",
    "release": "python3 tools/release.py",
    "test:safari": "node tools/test/run.mjs --compat safari",
    "test:firefox": "node tools/test/run.mjs --browser firefox",
    "test:webkit": "node tools/test/run.mjs --browser webkit"
  },
  "devDependencies": {
    "playwright": "1.56.0",
    "style-dictionary": "5.6.0"
  },
  "browser": "components/bundle.js",
  "engines": {
    "node": ">=20"
  }
}
