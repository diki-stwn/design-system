{
  "name": "serupa-ds",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "description": "Serupa, a design system by Diki: tokens, utility classes, page defaults, automatic dark mode and React components. Import the components as ES modules (React 18 or 19 is a peer dependency), or load dist/serupa.iife.js on a plain page, where it reads window.React (React 18.3.1 ships in dist/lib/).",
  "author": "Diki (https://github.com/diki-stwn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diki-stwn/serupa-ds.git"
  },
  "homepage": "https://github.com/diki-stwn/serupa-ds#readme",
  "bugs": {
    "url": "https://github.com/diki-stwn/serupa-ds/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/bundle.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./base.css": "./dist/base.css",
    "./bundle.css": "./dist/bundle.css",
    "./components.css": "./dist/components.css",
    "./utilities.css": "./dist/utilities.css",
    "./bundle.js": "./dist/bundle.js",
    "./serupa.iife.js": "./dist/serupa.iife.js",
    "./theme.js": "./dist/theme.js",
    "./design-tokens/*": "./design-tokens/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "tokens.css",
    "tokens.json",
    "fonts/",
    "licenses/",
    "design-tokens/",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "./dist/theme.js",
    "./dist/serupa.iife.js",
    "./dist/bundle.js"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "js-yaml@3": {
      "argparse": "2.0.1"
    }
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
