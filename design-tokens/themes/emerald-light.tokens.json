{
  "color": {
    "primary": {
      "$type": "color",
      "$value": "{color.emerald-700}",
      "$description": "Alias. Brand color: primary buttons, links, selected states. Light themes: brand 600 (emerald 700) with white text; dark themes: brand 400 with brand-950 text.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--primary"
        }
      }
    },
    "primary-hover": {
      "$type": "color",
      "$value": "{color.emerald-800}",
      "$description": "Alias. Hover / pressed state of `primary` (one step darker in light themes, lighter in dark).",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--primary-hover"
        }
      }
    },
    "primary-subtle": {
      "$type": "color",
      "$value": "{color.emerald-50}",
      "$description": "Alias. Brand tint for selected rows and badges (brand 50 light, brand 950 dark).",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--primary-subtle"
        }
      }
    },
    "on-primary": {
      "$type": "color",
      "$value": "{color.white}",
      "$description": "Alias. Text and icons on `primary` fills (white in light themes, brand 950 in dark).",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--on-primary"
        }
      }
    },
    "secondary": {
      "$type": "color",
      "$value": "{color.zinc-100}",
      "$description": "Alias. Secondary button fill; hover fill for outline and ghost buttons.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--secondary"
        }
      }
    },
    "secondary-hover": {
      "$type": "color",
      "$value": "{color.zinc-200}",
      "$description": "Alias. Hover state of `secondary`.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--secondary-hover"
        }
      }
    },
    "pressed": {
      "$type": "color",
      "$value": "{color.zinc-300}",
      "$description": "Alias. The fill while a row, tab, day or page button is held down (`:active`): one step past its hover. `text` keeps 7:1+ on it.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--pressed"
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": "{color.white}",
      "$description": "Alias. Page and card background (white light, zinc-950 dark).",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--surface"
        }
      }
    },
    "surface-muted": {
      "$type": "color",
      "$value": "{color.zinc-50}",
      "$description": "Alias. Secondary panels, sidebars, table headers.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--surface-muted"
        }
      }
    },
    "field": {
      "$type": "color",
      "$value": "{color.white}",
      "$description": "Alias. Background of text inputs, selects and other form fields.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--field"
        }
      }
    },
    "field-border": {
      "$type": "color",
      "$value": "{color.zinc-500}",
      "$description": "Alias. Border of form fields. 3:1+ against `field` and `surface` in every theme, as WCAG 1.4.11 requires for a control's boundary.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--field-border"
        }
      }
    },
    "field-border-hover": {
      "$type": "color",
      "$value": "{color.zinc-600}",
      "$description": "Alias. Field border on hover.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--field-border-hover"
        }
      }
    },
    "placeholder": {
      "$type": "color",
      "$value": "{color.zinc-500}",
      "$description": "Alias. Placeholder text in form fields (4.5:1+ on `field`). Placeholders are hints, never labels.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--placeholder"
        }
      }
    },
    "overlay": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0941,
          0.0941,
          0.1059
        ],
        "hex": "#18181b",
        "alpha": 0.502
      },
      "$description": "Alias. The dimmed backdrop behind dialogs and drawers (zinc-900 at 50% in light themes, zinc-950 at 70% in dark).",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--overlay"
        }
      }
    },
    "surface-inverse": {
      "$type": "color",
      "$value": "{color.zinc-900}",
      "$description": "Alias. Contrasting blocks: tooltips, inverse banners.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--surface-inverse"
        }
      }
    },
    "text": {
      "$type": "color",
      "$value": "{color.zinc-900}",
      "$description": "Alias. Body text and headings on `surface`.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--text"
        }
      }
    },
    "text-muted": {
      "$type": "color",
      "$value": "{color.zinc-500}",
      "$description": "Alias. Secondary text, captions, placeholders (4.5:1+ on `surface` in every theme).",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--text-muted"
        }
      }
    },
    "text-inverse": {
      "$type": "color",
      "$value": "{color.white}",
      "$description": "Alias. Text on `surface-inverse`.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--text-inverse"
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": "{color.zinc-200}",
      "$description": "Alias. Default borders and dividers.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--border"
        }
      }
    },
    "border-strong": {
      "$type": "color",
      "$value": "{color.zinc-300}",
      "$description": "Alias. Emphasised dividers and outlines. Form fields use `field-border`, which meets the 3:1 a control boundary needs.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--border-strong"
        }
      }
    },
    "focus-ring": {
      "$type": "color",
      "$value": "{color.emerald-600}",
      "$description": "Alias. Keyboard focus outline, in the brand hue (3:1+ on `surface` in every theme).",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--focus-ring"
        }
      }
    },
    "success": {
      "$type": "color",
      "$value": "{color.green-600}",
      "$description": "Alias. Success icons and fills. For success text on light surfaces use `green-700`.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--success"
        }
      }
    },
    "success-subtle": {
      "$type": "color",
      "$value": "{color.green-50}",
      "$description": "Alias. Success alert / badge background.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--success-subtle"
        }
      }
    },
    "warning": {
      "$type": "color",
      "$value": "{color.amber-600}",
      "$description": "Alias. Warning icons and fills; put dark text on it. For warning text on light surfaces use `amber-700`.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--warning"
        }
      }
    },
    "warning-subtle": {
      "$type": "color",
      "$value": "{color.amber-50}",
      "$description": "Alias. Warning alert / badge background.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--warning-subtle"
        }
      }
    },
    "danger": {
      "$type": "color",
      "$value": "{color.red-600}",
      "$description": "Alias. Errors, destructive buttons; white text on it (4.8:1). For error text on dark surfaces use `red-400`.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--danger"
        }
      }
    },
    "danger-hover": {
      "$type": "color",
      "$value": "{color.red-700}",
      "$description": "Alias. Hover / pressed state of `danger`.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--danger-hover"
        }
      }
    },
    "on-danger": {
      "$type": "color",
      "$value": "{color.white}",
      "$description": "Alias. Text and icons on `danger` fills.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--on-danger"
        }
      }
    },
    "danger-subtle": {
      "$type": "color",
      "$value": "{color.red-50}",
      "$description": "Alias. Error alert / badge background.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--danger-subtle"
        }
      }
    },
    "danger-text": {
      "$type": "color",
      "$value": "{color.red-700}",
      "$description": "Alias. Destructive text and icons on `surface`, `danger-subtle` and its hover (5.3:1+ in every theme).",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--danger-text"
        }
      }
    },
    "danger-subtle-hover": {
      "$type": "color",
      "$value": "{color.red-100}",
      "$description": "Alias. Hover fill for destructive secondary, outline and ghost buttons.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--danger-subtle-hover"
        }
      }
    },
    "danger-border": {
      "$type": "color",
      "$value": "{color.red-300}",
      "$description": "Alias. Border of a destructive outline button.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--danger-border"
        }
      }
    },
    "info": {
      "$type": "color",
      "$value": "{color.sky-700}",
      "$description": "Alias. Informational icons and text.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--info"
        }
      }
    },
    "info-subtle": {
      "$type": "color",
      "$value": "{color.sky-50}",
      "$description": "Alias. Info alert / badge background.",
      "$extensions": {
        "com.serupa": {
          "cssVar": "--info-subtle"
        }
      }
    }
  }
}
